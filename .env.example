# ---------------------------------------------------------------------------
# Copy to .env.local. Never commit that file.
# Server-only values — do NOT prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# better-auth service. No trailing slash. Verified: basePath is /api/auth.
AUTH_SERVICE_URL=http://localhost:8080

# REST API protected by the auth service's JWKS. No trailing slash.
# Verified dev host: uvicorn on :8000 (FastAPI).
API_URL=http://localhost:8000

# Optional: the bucket or CDN root in front of project output. A project's
# `source` reports keys relative to it (`79b7…/master.m3u8`), never URLs, so the
# video page joins them onto this. No trailing slash. Unset means the page
# explains that playback is not configured instead of rendering a dead player.
# MEDIA_BASE_URL=https://media.example.com

MEDIA_SEGMENT_BASE_URL=https://your-segment-host.example.com

# Public, inlined into the client bundle at build time.
NEXT_PUBLIC_APP_NAME=Ryld
